    "redis": "5.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
