enum TokenTransactionType {
  earn
  spend
  adjustment
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  USER
}

enum Network {
  testnet
  mainnet
}

enum Status {
  pending
  confirmed
  failed
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MenuCategory {
  FOOD
  DRINKS
}

// New enums for metrics system
enum MetricCategory {
  SALES
  CUSTOMER
  STAFF
  INVENTORY
  FINANCIAL
  OPERATIONAL
}

enum ReportFormat {
  PDF
  CSV
  EXCEL
  JSON
  HTML
}

enum AggregationPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Original models
model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String?
  role          UserRole         @default(STAFF)
  password      String
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  wallets       StellarWallet[]
  session       Session[]
  refreshTokens RefreshToken[]
  reservations  Reservation[]
  orders        Order[]
  statusChanges OrderStatusHistory[]
  changedStatuses ReservationStatusHistory[] @relation("ChangedByUser")
  reports       Report[]
  loyaltyToken LoyaltyToken?
  rewardRedemptions RewardRedemption[]
  
  // Review and Feedback Relations
  reviews                Review[]
  reviewHelpfulVotes     ReviewHelpfulVote[]
  reviewReports          ReviewReport[] @relation("ReportedByUser")
  feedback               Feedback[] @relation("CreatedByUser")
  feedbackResponses      FeedbackResponse[]
  moderatedReviews       ReviewModerationHistory[] @relation("ModeratedByUser")
}

model LoyaltyToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TokenTransaction[]

  @@index([userId])
}

model TokenTransaction {
  id           String   @id @default(uuid())
  loyaltyTokenId String
  type         TokenTransactionType
  amount       Int
  description  String?
  createdAt    DateTime @default(now())

  loyaltyToken LoyaltyToken @relation(fields: [loyaltyTokenId], references: [id], onDelete: Cascade)

  @@index([loyaltyTokenId])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  cost        Int      // tokens required
  inventory   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id         String   @id @default(uuid())
  userId     String
  rewardId   String
  status     Status
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@index([userId, rewardId])
}

model StellarWallet {
  id          String   @id @default(uuid())
  publicKey   String   @unique
  secretKey   String   // ENCRYPTED: Must be encrypted before storage using EncryptionService
  network     Network
  balance     Decimal  @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Table {
  id           String        @id @default(uuid())
  name         String
  capacity     Int
  location     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Transaction {
  id            String        @id @default(uuid())
  hash          String        @unique
  amount        Decimal
  fee           Decimal
  status        Status
  walletId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  wallet        StellarWallet @relation(fields: [walletId], references: [id])
}

model Reservation {
  id          String                     @id @default(uuid())
  userId      String
  tableId     String
  startTime   DateTime
  endTime     DateTime
  partySize   Int
  status      ReservationStatus          @default(PENDING)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  user        User                       @relation(fields: [userId], references: [id])
  table       Table                      @relation(fields: [tableId], references: [id])
  statusHistory ReservationStatusHistory[]
}

model ReservationStatusHistory {
  id            String            @id @default(uuid())
  reservationId String
  status        ReservationStatus
  changedAt     DateTime          @default(now())
  changedById   String
  notes         String?
  reservation   Reservation       @relation(fields: [reservationId], references: [id])
  changedBy     User              @relation("ChangedByUser", fields: [changedById], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model MenuItem {
  id          String        @id @default(uuid())
  name        String
  description String?
  price       Decimal
  category    MenuCategory
  available   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItems  OrderItem[]
  
  // Review Relations
  reviews Review[]
}

model Order {
  id            String               @id @default(uuid())
  userId        String
  status        OrderStatus          @default(PENDING)
  total         Decimal
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  
  // Review and Feedback Relations
  reviews   Review[]
  feedback  Feedback[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  changedAt DateTime    @default(now())
  changedBy String
  notes     String?
  order     Order       @relation(fields: [orderId], references: [id])
  user      User        @relation(fields: [changedBy], references: [id])
}

// Metrics system models
model Metric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  value       Float
  timestamp   DateTime @default(now())
  category    MetricCategory
  source      String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  aggregations MetricAggregation[]

  @@index([category, timestamp])
  @@index([name, timestamp])
  @@index([source, timestamp])
  @@map("metrics")
}

model MetricAggregation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricId    String   @db.Uuid
  metric      Metric   @relation(fields: [metricId], references: [id])
  period      AggregationPeriod
  startTime   DateTime
  endTime     DateTime
  value       Float
  count       Int
  min         Float
  max         Float
  avg         Float
  sum         Float
  stdDev      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([metricId, period, startTime])
  @@index([period, startTime, endTime])
  @@map("metric_aggregations")
}

model Report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  query       String
  parameters  Json?
  schedule    String?
  format      ReportFormat @default(JSON)
  isActive    Boolean      @default(true) @map("is_active")
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  creator     User         @relation(fields: [createdBy], references: [id])
  executions  ReportExecution[]
  
  @@index([createdBy])
  @@index([isActive])
  @@map("reports")
}

model ReportExecution {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String   @db.Uuid
  status      ReportExecutionStatus @default(RUNNING)
  startTime   DateTime              @map("start_time")
  endTime     DateTime?             @map("end_time")
  filePath    String?               @map("file_path")
  fileSize    Int?                  @map("file_size")
  errorMessage String?              @map("error_message")
  parameters  Json?
  createdAt   DateTime              @default(now()) @map("created_at")
  
  report      Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  @@index([reportId, status])
  @@index([startTime])
  @@map("report_executions")
}

model MetricSnapshot {
  id          String         @id @default(uuid())
  category    MetricCategory
  snapshot    Json
  timestamp   DateTime       @default(now())
  retentionDate DateTime     @map("retention_date")
  compressed  Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")
  
  @@index([category, timestamp])
  @@index([retentionDate])
  @@map("metric_snapshots")
}

// Review and Feedback System Enums
enum ReviewStatus {
  pending
  approved
  rejected
  flagged
}

enum FeedbackStatus {
  open
  in_progress
  resolved
  closed
}

enum FeedbackPriority {
  low
  medium
  high
  urgent
}

enum FeedbackCategory {
  service
  food_quality
  ambiance
  pricing
  staff
  general
}

enum ReviewType {
  product
  service
  overall
}

enum ModerationAction {
  approve
  reject
  flag
  edit
}

// Review System Models
model Review {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  orderId           String?     @map("order_id")
  menuItemId        String?     @map("menu_item_id")
  rating            Int         @db.SmallInt
  content           String?
  status            ReviewStatus @default(pending)
  helpfulVotesCount Int         @default(0) @map("helpful_votes_count")
  totalVotesCount   Int         @default(0) @map("total_votes_count")
  isVerified        Boolean     @default(false) @map("is_verified")
  isAnonymous       Boolean     @default(false) @map("is_anonymous")
  moderationNotes   String?     @map("moderation_notes")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  menuItem          MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  helpfulVotes      ReviewHelpfulVote[]
  reports           ReviewReport[]
  moderationHistory ReviewModerationHistory[]

  @@index([userId])
  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  isHelpful Boolean  @map("is_helpful")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_helpful_votes")
}

model ReviewReport {
  id          String   @id @default(uuid())
  reviewId    String   @map("review_id")
  userId      String   @map("user_id")
  reason      String
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation("ReportedByUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@index([status])
  @@map("review_reports")
}

model ReviewModerationHistory {
  id          String          @id @default(uuid())
  reviewId    String          @map("review_id")
  moderatorId String          @map("moderator_id")
  action      ModerationAction
  reason      String?
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderator User   @relation("ModeratedByUser", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([moderatorId])
  @@index([createdAt])
  @@map("review_moderation_history")
}

// Feedback System Models
model Feedback {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  orderId     String?          @map("order_id")
  category    FeedbackCategory
  priority    FeedbackPriority @default(medium)
  status      FeedbackStatus   @default(open)
  subject     String
  message     String
  attachments String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  user      User              @relation("CreatedByUser", fields: [userId], references: [id], onDelete: Cascade)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  responses FeedbackResponse[]
  history   FeedbackHistory[]

  @@index([userId])
  @@index([orderId])
  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

model FeedbackResponse {
  id         String   @id @default(uuid())
  feedbackId String   @map("feedback_id")
  userId     String   @map("user_id")
  message    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([userId])
  @@index([createdAt])
  @@map("feedback_responses")
}

model FeedbackHistory {
  id          String   @id @default(uuid())
  feedbackId String   @map("feedback_id")
  field       String
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  changedBy   String   @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("feedback_history")
}

// Analytics Models
model ReviewAnalytics {
  id              String   @id @default(uuid())
  menuItemId      String?  @map("menu_item_id")
  totalReviews    Int      @default(0) @map("total_reviews")
  averageRating   Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)
  ratingDistribution Json   @default("{}") @map("rating_distribution")
  helpfulnessScore Decimal @default(0) @map("helpfulness_score") @db.Decimal(3, 2)
  period          String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([menuItemId])
  @@index([period])
  @@index([startDate, endDate])
  @@map("review_analytics")
}

model FeedbackAnalytics {
  id              String   @id @default(uuid())
  category        FeedbackCategory
  totalFeedback   Int      @default(0) @map("total_feedback")
  resolvedCount   Int      @default(0) @map("resolved_count")
  averageResolutionTime Int @default(0) @map("average_resolution_time")
  period          String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([period])
  @@index([startDate, endDate])
  @@map("feedback_analytics")
}